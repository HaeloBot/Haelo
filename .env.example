# Copy to .env (never commit .env) or export these in the shell that launches Haelo.
# Haelo reads secrets ONLY from the environment. haelo.yaml names the variables; it never holds values.

# --- Alpaca (broker.type: alpaca) --------------------------------------------
# A free paper account is enough: https://alpaca.markets  (paper keys start with PK...)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
# Only needed for the live rungs (micro, standard). Leave empty until you mean it.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# --- Robinhood Crypto Trading API (broker.type: robinhood-crypto, US only) ----
RH_CRYPTO_API_KEY=
# Base64 of the 32-byte Ed25519 private key seed you generated for the API credential.
RH_CRYPTO_PRIVATE_KEY=

# --- Upstream MCP server with a static bearer token (broker.type: mcp-upstream) ---
# Not needed for Robinhood's official MCP, which uses OAuth: run `haelo auth` instead.
# UPSTREAM_MCP_TOKEN=

# --- Haelo itself --------------------------------------------------------------
# Bearer token that agents must send to the HTTP transport (>= 16 chars).
# If unset, Haelo generates one and stores it at <stateDir>/http-token with mode 600.
# HAELO_HTTP_TOKEN=
# Path to the policy file (default ./haelo.yaml).
# HAELO_CONFIG=
