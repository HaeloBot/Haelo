# Haelo reads secrets only from the environment or the OS keychain. Never commit real values.
# Quotes, shadow and paper need none of these.

# Signing key for live swaps. Prefer `haelo key import --file ~/.config/solana/id.json` (OS keychain) over these.
# Set at most one: a base58 secret key / JSON byte array, or a path to a chmod 600 keypair file.
HAELO_PRIVATE_KEY=
HAELO_KEYPAIR=

# Watch-only wallet for balances and paper simulation when no key is loaded.
HAELO_ADDRESS=

# Private mainnet RPC (recommended for live use). Overrides broker.rpcUrl.
HAELO_RPC_URL=

# Optional Jupiter API key. Without it the keyless tier is used.
HAELO_JUPITER_API_KEY=

# Bearer token for `haelo serve --http`. Generated and stored in the state dir if unset.
HAELO_HTTP_TOKEN=

# Path to haelo.yaml if not ./haelo.yaml
HAELO_CONFIG=
